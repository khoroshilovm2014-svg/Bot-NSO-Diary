# ---------------------------------------------------------------------------
# NSO Diary — переменные окружения.
# Скопируйте файл: cp .env.example .env  и заполните значения.
# ---------------------------------------------------------------------------

# --- Telegram ---------------------------------------------------------------
# Токен от @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe
# Юзернейм бота без @ (нужен для deep link t.me/<username>)
BOT_USERNAME=NSODiaryBot

# Публичный адрес API (по нему Telegram ходит в webhook и открывает мини-апп)
PUBLIC_BASE=https://api.nso-diary.ru
# Адрес мини-приложения (по умолчанию PUBLIC_BASE/tg-app/)
# WEBAPP_URL=https://api.nso-diary.ru/tg-app/

# Секрет в пути webhook: /tg/webhook/<WEBHOOK_SECRET>
WEBHOOK_SECRET=change-me-to-random-string

# --- Supabase ---------------------------------------------------------------
# Project URL вида https://xxxxx.supabase.co
SUPABASE_URL=https://surbkjmviyyvvrajhjkp.supabase.co
# ТОЛЬКО service_role ключ. Никогда не попадает в браузер.
SUPABASE_SERVICE_KEY=

# --- Приложение -------------------------------------------------------------
# Секрет для JWT-сессий (любая длинная случайная строка)
JWT_SECRET=change-me-to-random-string

# Откуда можно обращаться к API (сайт + локальная разработка)
CORS_ORIGINS=https://nso-diary.ru,https://www.nso-diary.ru,http://localhost:5500,http://127.0.0.1:5500

# Демо-режим: без Supabase данные хранятся в памяти, создаётся ученик demo/demo.
# В продакшене — 0.
DEMO_MODE=0

# Время жизни (секунды)
AUTH_REQUEST_TTL=600
CODE_TTL=300
TOKEN_TTL=43200
MAX_CODE_ATTEMPTS=6
